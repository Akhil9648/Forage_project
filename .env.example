# Slack Integration Configuration (Socket Mode)
# SLACK_BOT_TOKEN begins with xoxb- (Bot User OAuth Token)
SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_APP_TOKEN begins with xapp- (App-Level Token for Socket Mode)
SLACK_APP_TOKEN=xapp-your-app-token

# Agent Orchestration Settings
PORT=3000
WORKSPACE_PATH=c:\Users\akhil\Forage
DB_PATH=data/memory.db

# LLM Configuration (Groq API Cloud)
GROQ_API_KEY=gsk_your-groq-key
# Specify the model you want to use (e.g., llama-3.1-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768)
GROQ_MODEL=llama-3.1-70b-versatile

# Autonomous Cron Expression (Default: every hour)
AUTONOMOUS_CRON_INTERVAL="0 * * * *"
